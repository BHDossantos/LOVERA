MM_ENV=local
MM_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/matchmaker
MM_SECRET_KEY=change-me-to-a-long-random-string
MM_CORS_ORIGINS=["http://localhost:3000"]
# AI gateway: auto uses Anthropic when a key is present, else the deterministic sandbox provider
MM_AI_PROVIDER=auto
MM_ANTHROPIC_API_KEY=
MM_ANTHROPIC_MODEL=claude-opus-5
# Vendors (sandbox by default)
MM_IDENTITY_PROVIDER=sandbox
MM_IDENTITY_WEBHOOK_SECRET=change-me
MM_PAYMENTS_PROVIDER=sandbox
MM_PAYMENTS_WEBHOOK_SECRET=change-me
MM_EXPOSE_DEV_OTP=true
# Outbound email. Leave MM_SMTP_HOST empty for local work: the transport falls back
# to "console", which logs the sign-in code instead of sending it. Any provider that
# speaks SMTP works; production refuses to start without a host. See docs/DEPLOY.md.
MM_MAIL_TRANSPORT=auto
MM_MAIL_FROM=Lovera <no-reply@localhost>
MM_SMTP_HOST=
MM_SMTP_PORT=587
MM_SMTP_USERNAME=
MM_SMTP_PASSWORD=
MM_SMTP_SECURITY=starttls

# In-app purchase. disabled (the default) means the phone is told the store is off and draws no
# purchase UI at all. sandbox trusts the receipt and is refused outright in production.
# app_store / play_store verify with the store itself (apps/api/app/modules/billing/stores.py);
# set one, with its credentials, and a receipt from the other store is refused rather than
# guessed at. A missing credential keeps purchases off and says so at boot. See
# docs/STORE-SUBMISSION.md §8.
MM_STORE_VALIDATION=disabled
# App Store Connect → Users and Access → Integrations → App Store Connect API. The private key is
# the .p8 that page downloads once: raw PEM, PEM with literal \n, or base64 of the file.
MM_APP_STORE_ISSUER_ID=
MM_APP_STORE_KEY_ID=
MM_APP_STORE_PRIVATE_KEY=
MM_APP_STORE_BUNDLE_ID=com.joinlovera.app
MM_APP_STORE_ENVIRONMENT=auto
# The Play service account JSON (or base64 of it). The account needs "View app information" and
# "Release apps to testing tracks" on this app — being listed on the developer account is not
# enough, and Google's own error does not say so.
MM_PLAY_SERVICE_ACCOUNT_JSON=
MM_PLAY_PACKAGE_NAME=com.joinlovera.app
