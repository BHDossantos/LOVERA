MM_ENV=local
MM_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/matchmaker
MM_SECRET_KEY=change-me-to-a-long-random-string
MM_CORS_ORIGINS=["http://localhost:3000"]
# AI gateway: auto uses Anthropic when a key is present, else the deterministic sandbox provider
MM_AI_PROVIDER=auto
MM_ANTHROPIC_API_KEY=
MM_ANTHROPIC_MODEL=claude-opus-5
# Vendors (sandbox by default)
MM_IDENTITY_PROVIDER=sandbox
MM_IDENTITY_WEBHOOK_SECRET=change-me
MM_PAYMENTS_PROVIDER=sandbox
MM_PAYMENTS_WEBHOOK_SECRET=change-me
MM_EXPOSE_DEV_OTP=true
